HloModule m

%callee {
  %p = f32[] parameter(0)
  ROOT %n = f32[] negate(%p)
}

%body {
  %p = f32[] parameter(0)
  ROOT %n = f32[] negate(%p)
}

%cond {
  %p = f32[] parameter(0)
  %z = f32[] constant(0)
  ROOT %c = pred[] compare(%p, %z), direction=GT
}

ENTRY %e {
  %p0 = f32[] parameter(0)
  %call = f32[] call(%p0), to_apply=%callee, frontend_attributes={inlineable="false"}
  ROOT %w = f32[] while(%call), condition=%cond, body=%body
}
