HloModule pjit_f, allow_spmd_sharding_propagation_to_parameters={false,false,false}, num_partitions=8, frontend_attributes={xla.sdy.use_tuple_args="t"}

ENTRY %main.7 {
  %Arg_0.1 = f32[8,16] parameter(0)
  %Arg_1.1 = f32[16,32] parameter(1)
  %dot.4 = f32[8,32] dot(f32[8,16]{1,0} %Arg_0.1, f32[16,32]{1,0} %Arg_1.1), lhs_contracting_dims={1}, rhs_contracting_dims={0}
  %Arg_2.3 = f32[8,32] parameter(2)
  %add.5 = f32[8,32] add(f32[8,32] %dot.4, f32[8,32] %Arg_2.3)
  %p0 = f32[8,256,512] parameter(3), sharding={devices=[2,2,2]0,1,2,3,4,5,6,7 metadata={op_name="a"}}
  %p1 = f32[8,128,512] parameter(4), sharding={devices=[2,2,2]0,1,2,3,4,5,6,7 metadata={op_name="b"}}
  %dot = f32[8,256,128] dot(%p0, %add.5), lhs_batch_dims={0}, rhs_batch_dims={0}, lhs_contracting_dims={2}, rhs_contracting_dims={2}
  %copy = f32[8,256,128] copy(%dot)
  ROOT %ffl.root = (f32[8,32], f32[8,256,128]) tuple(%add.5, %copy)
}
