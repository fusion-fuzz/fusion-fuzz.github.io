HloModule m

cmp {
  a = f32[] parameter(0)
  b = f32[] parameter(1)
  c = s32[] parameter(2)
  d = s32[] parameter(3)
  ROOT r = pred[] compare(a, b), direction=GT
}

ENTRY e {
  p = f32[128] parameter(0)
  ROOT t = (f32[8,32], s32[8,32]) custom-call(p), custom_call_target="TopK", called_computations={cmp}
}
