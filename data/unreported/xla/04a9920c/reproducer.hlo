HloModule XPlusY

ENTRY %main {
  %x = f32[10] parameter(0)
  %y = f32[10] parameter(1)
  %res = f32[10] add(x, y)
  %input = f32[1,3,5,5]{3,2,1,0} parameter(2)
  %kernel = f32[3,3,3,3]{3,2,1,0} parameter(3)
  %custom-call = (f32[1,3,5,5]{3,2,1,0}, u8[0]{0}) custom-call(%input, %y), window={size=3x3 pad=1_2x1_2 rhs_dilate=2x2}, dim_labels=bf01_01io->bf01, custom_call_target="__cudnn$convForward"
  ROOT %ffl.root = (f32[10], (f32[1,3,5,5]{3,2,1,0}, u8[0]{0})) tuple(%res, %custom-call)
}
