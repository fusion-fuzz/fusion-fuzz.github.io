  %rhs_bf16 = bf16[192,48]{1,0} convert(rhs)
  %lhs_scaled = bf16[2,16,192]{2,1,0} multiply(scale_lhs_bcast, lhs_bf16)
  %rhs_scaled = bf16[192,48]{1,0} multiply(scale_rhs_bcast, rhs_bf16)
  %dot = bf16[2,16,48]{2,1,0} dot(lhs_scaled, rhs_scaled), lhs_contracting_dims={2}, rhs_contracting_dims={0}
  %custom-call = bf16[2,16,48]{2,1,0} custom-call(dot), custom_call_target="Sharding", sharding={devices=[1,4,1]<=[4]}
  %ffl.root = (bf16[2,16,48]{2,1,0}, f32[8,128]) tuple(%custom-call, %copy)
  %p0.d = f32[8,512] parameter(6), sharding={devices=[1,2,2]0,1,2,3 last_tile_dims={manual} metadata={op_name="a"}}
  %copy1.d = f32[512,128] copy(%copy1)
  %dot.d.1 = f32[8,128] dot(%p0.d, %copy1.d), lhs_batch_dims={}, rhs_batch_dims={}, lhs_contracting_dims={1}, rhs_contracting_dims={0}, sharding={devices=[1,1,2,2]0,1,2,3 last_tile_dims={replicated, manual} metadata={op_name="b"}}
  %copy.d = f32[8,128] copy(%dot.d.1)
  ROOT %ffl.root.1 = (bf16[2,16,48]{2,1,0}, f32[8,128], f32[8,128]) tuple(%custom-call, %copy, %copy.d)
