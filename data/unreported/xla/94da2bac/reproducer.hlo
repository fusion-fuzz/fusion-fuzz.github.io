HloModule my_module

%async_computation {
  %p = f32[1024] parameter(0)
  ROOT %custom-call = f32[1024] custom-call(p), custom_call_target="foo"
}

%while_cond {
  %param = (s32[], ((f32[1024]), f32[1024], s32[])) parameter(0)
  %count = s32[] get-tuple-element(param), index=0
  %limit = s32[] constant(10)
  ROOT %cmp = pred[] compare(count, limit), direction=LT
}

%while_body {
  %param = (s32[], ((f32[1024]), f32[1024], s32[])) parameter(0)
  %count = s32[] get-tuple-element(param), index=0
  %one = s32[] constant(1)
  %new_count = s32[] add(count, one)
  %async_state = ((f32[1024]), f32[1024], s32[]) get-tuple-element(param), index=1
  %async_update = ((f32[1024]), f32[1024], s32[]) async-update(async_state), calls=%async_computation
  ROOT %body_root = (s32[], ((f32[1024]), f32[1024], s32[])) tuple(new_count, async_state)
}

%async_computation.d {
  %p = f32[1024] parameter(0)
  ROOT %custom-call = f32[1024] custom-call(p), custom_call_target="foo"
}

%while_cond.d {
  %param = (s32[], ((f32[1024]), f32[1024], s32[])) parameter(0)
  %count = s32[] get-tuple-element(param), index=0
  %limit = s32[] constant(10)
  ROOT %cmp = pred[] compare(count, limit), direction=LT
}

%while_body.d {
  %param = (s32[], ((f32[1024]), f32[1024], s32[])) parameter(0)
  %count = s32[] get-tuple-element(param), index=0
  %one = s32[] constant(1)
  %new_count = s32[] add(count, one)
  %async_state = ((f32[1024]), f32[1024], s32[]) get-tuple-element(param), index=1
  %async_update = ((f32[1024]), f32[1024], s32[]) async-update(async_state), calls=%async_computation.d
  ROOT %body_root = (s32[], ((f32[1024]), f32[1024], s32[])) tuple(new_count, async_state)
}

%async_computation.d.1 {
  %p = f32[1024] parameter(0)
  ROOT %custom-call = f32[1024] custom-call(p), custom_call_target="foo"
}

%while_cond.d.1 {
  %param = (s32[], ((f32[1024]), f32[1024], s32[])) parameter(0)
  %count = s32[] get-tuple-element(param), index=0
  %limit = s32[] constant(10)
  ROOT %cmp = pred[] compare(count, limit), direction=LT
}

%while_body.d.1 {
  %param = (s32[], ((f32[1024]), f32[1024], s32[])) parameter(0)
  %count = s32[] get-tuple-element(param), index=0
  %one = s32[] constant(1)
  %new_count = s32[] add(count, one)
  %async_state = ((f32[1024]), f32[1024], s32[]) get-tuple-element(param), index=1
  %async_update = ((f32[1024]), f32[1024], s32[]) async-update(async_state), calls=%async_computation.d.1
  ROOT %body_root = (s32[], ((f32[1024]), f32[1024], s32[])) tuple(new_count, async_state)
}

ENTRY %main {
  %constant = f32[] constant(0)
  %broadcast_0 = f32[1024] broadcast(constant), dimensions={}
  %offload = f32[1024] custom-call(broadcast_0), custom_call_target="MoveToHost"
  %param = f32[1024] parameter(0)
  %constant_f32_1 = f32[] constant(1)
  %broadcast = f32[1024] broadcast(constant_f32_1), dimensions={}
  %add = f32[1024] add(broadcast, broadcast)
  %mth = f32[1024] custom-call(add), custom_call_target="MoveToHost"
  %async-start = ((f32[1024]), f32[1024], s32[]) async-start(%mth), calls=%async_computation
  %start_count = s32[] constant(0)
  %iter_init = (s32[], ((f32[1024]), f32[1024], s32[])) tuple(%start_count, %async-start)
  %while_loop = (s32[], ((f32[1024]), f32[1024], s32[])) while(%iter_init), condition=%while_cond, body=%while_body
  %final_async_state = ((f32[1024]), f32[1024], s32[]) get-tuple-element(%while_loop), index=1
  %async-done = f32[1024] async-done(%final_async_state), calls=%async_computation
  %constant_s32_0 = s32[] constant(0)
  %update_slice = f32[1024] dynamic-update-slice(offload, mth, constant_s32_0)
  %mtd = f32[1024] custom-call(update_slice), custom_call_target="MoveToDevice"
  %root = f32[1024] add(mtd, mtd)
  %ffl.root = (f32[1024], f32[1024]) tuple(%root, %async-done)
  %async-start.d = ((f32[1024]), f32[1024], s32[]) async-start(%param), calls=%async_computation.d
  %start_count.d = s32[] constant(0)
  %iter_init.d = (s32[], ((f32[1024]), f32[1024], s32[])) tuple(%start_count.d, %async-start.d)
  %while_loop.d = (s32[], ((f32[1024]), f32[1024], s32[])) while(%iter_init.d), condition=%while_cond.d.1, body=%while_body.d
  %final_async_state.d = ((f32[1024]), f32[1024], s32[]) get-tuple-element(%while_loop.d), index=1
  %async-done.d = f32[1024] async-done(%final_async_state.d), calls=%async_computation.d
  ROOT %ffl.root.1 = (f32[1024], f32[1024], f32[1024]) tuple(%root, %async-done, %async-done.d)
}
