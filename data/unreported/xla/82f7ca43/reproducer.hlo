HloModule m

ENTRY %e {
  %p0 = bf16[12,2] parameter(0)
  %p1 = bf16[2,44] parameter(1)
  %d = bf16[12,44] dot(p0, p1), lhs_batch_dims={}, lhs_contracting_dims={1}, rhs_batch_dims={}, rhs_contracting_dims={0}
  %p = f32[4,2,3]{0,1,2} parameter(2)
  %r = f32[8,3]{1,0} reshape(%p0)
  %r.d = f32[8,3]{1,0} reshape(%p)
  %ffl.root = (bf16[12,44], f32[8,3]{1,0}) tuple(%d, %r)
  ROOT %ffl.root.1 = (bf16[12,44], f32[8,3]{1,0}, f32[8,3]{1,0}) tuple(%d, %r, %r.d)
}
