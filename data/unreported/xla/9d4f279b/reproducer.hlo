HloModule m

async_comp {
  p0 = f32[2,4] parameter(0)
  p1 = f32[2,4] parameter(1)
  ROOT add = f32[2,4] add(p0, p1)
}

ENTRY main {
  p0 = f32[2,4] parameter(0)
  p1 = f32[2,4] parameter(1)
  start = ((f32[2,4]), (), s32[]) call-start(p0), to_apply=async_comp
  barrier = ((f32[2,4]), (), s32[]) opt-barrier(start)
  update = ((f32[2,4], f32[2,4]), f32[2,4], ()) call-update(barrier, p1)
  ROOT done = f32[2,4] call-done(update)
}
