HloModule test

%async_computation {
  %p0 = f32[2,3] parameter(0)
  ROOT %abs = f32[2,3] abs(p0)
}

ENTRY %main {
  %p0 = f32[2,3] parameter(0)
  %sc-start = ((f32[2,3]), f32[2,3], s32[]) call-start(p0), to_apply=async_computation
  %done = f32[2,3] call-done(sc-start)
  %p0.d = f32[1, 8] parameter(1)
  %p1 = f32[2, 1] parameter(2)
  %p2 = s32[2, 1] parameter(3)
  %convolution.1 = f32[1, 1] convolution(%p0.d, %p1, %p0), dim_labels=bf_io->bf, sparsity_config={ rhs={sparsity=1x4 dimension=0 stride=1 idx=2} }
  %convolution.1.d = f32[1, 1] convolution(%p0.d, %p1, %p2), dim_labels=bf_io->bf, sparsity_config={ rhs={sparsity=1x4 dimension=0 stride=1 idx=2} }
  %ffl.root = (f32[2,3], f32[1, 1]) tuple(%done, %convolution.1)
  ROOT %ffl.root.1 = (f32[2,3], f32[1, 1], f32[1, 1]) tuple(%done, %convolution.1, %convolution.1.d)
}
