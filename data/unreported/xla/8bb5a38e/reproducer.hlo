HloModule topk

ENTRY %TopK {
  %x = f32[10,10]{0,1} parameter(0)
  %topk = (f32[10,2]{0,1}, s32[10,2]{0,1}) topk(x), k=2, largest=true
  %b = f32[10,10]{0,1:T(8,128)} bitcast(%x)
  %c = f32[10,10]{0,1:T(8,128)} add(%b, %b)
  %ffl.root = ((f32[10,2]{0,1}, s32[10,2]{0,1}), f32[10,10]{0,1:T(8,128)}) tuple(%topk, %c)
  %a = f32[10,10]{0,1:T(8,128)} parameter(1)
  %b.d = f32[10,10]{0,1:T(8,128)} bitcast(%b)
  %c.d = f32[10,10]{0,1:T(8,128)} add(%b.d, %b.d)
  ROOT %ffl.root.1 = ((f32[10,2]{0,1}, s32[10,2]{0,1}), f32[10,10]{0,1:T(8,128)}, f32[10,10]{0,1:T(8,128)}) tuple(%topk, %c, %c.d)
}
