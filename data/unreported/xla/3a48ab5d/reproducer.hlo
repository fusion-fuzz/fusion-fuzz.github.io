HloModule module

%callee {
  %p = f32[1,8,1,7] parameter(0)
  ROOT %r = f32[8,7] reshape(p)
}

ENTRY %main {
  %param0 = f32[10] parameter(0)
  %result = f32[10] add(param0, param0)
  %ffl.call = f32[8,7] call(%result), to_apply=%callee
  ROOT %ffl.root = (f32[10], f32[8,7]) tuple(%result, %ffl.call)
}
