HloModule module

%concatenate {
  %p0 = bf16[6] parameter(0)
  ROOT %concatenate = bf16[12] concatenate(p0, p0), dimensions={0}
}

%async_computation {
  %p0 = f32[4] parameter(0)
  %p1 = f32[4] parameter(1)
  %add = f32[4] add(p0, p1)
  %negate = f32[4] negate(p0)
  ROOT %tuple = (f32[4], f32[4]) tuple(add, negate)
}

ENTRY %main {
  %p0 = bf16[6] parameter(0)
  %x = f32[4] constant({1.0, 2.0, 3.0, 4.0})
  %y = f32[4] constant({10.0, 20.0, 30.0, 40.0})
  %async-start = ((), (), s32[]) async-start(), calls=%async_computation, async_execution_thread="thread"
  %async-update0 = ((f32[4]), (), s32[]) async-update(%async-start, %x)
  %async-update1 = ((f32[4], f32[4]), (f32[4], f32[4]), s32[]) async-update(%async-update0, %y)
  %async-done = (f32[4], f32[4]) async-done(%async-update1)
  %fusion = bf16[12] fusion(p0), kind=kCustom, calls=concatenate
  ROOT %ffl.root = (bf16[12], (f32[4], f32[4])) tuple(%fusion, %async-done)
}
