HloModule test_module

ENTRY %main {
  %a = f32[] parameter(0)
  %b = f32[] parameter(1)
  %input = s8[32,10,10,10,64] parameter(2)
  %filter = s8[2,2,2,64,128] parameter(3)
  %result = (s8[32,10,10,10,128], u8[0]) custom-call(%input, %filter), window={size=2x2}, dim_labels=b012f_012io->b012f, custom_call_target="__cudnn$convForward"
  %res = f32[] multiply(f32[] %a, f32[] %b)
  %ffl.root = (f32[], (s8[32,10,10,10,128], u8[0])) tuple(%res, %result)
  %input.d = s8[32,10,10,10,64] parameter(4)
  %filter.d = s8[2,2,2,64,128] parameter(5)
  %result.d = (s8[32,10,10,10,128], u8[0]) custom-call(%input, %filter.d), window={size=2x2}, dim_labels=b012f_012io->b012f, custom_call_target="__cudnn$convForward"
  ROOT %ffl.root.1 = (f32[], (s8[32,10,10,10,128], u8[0]), (s8[32,10,10,10,128], u8[0])) tuple(%res, %result, %result.d)
}
