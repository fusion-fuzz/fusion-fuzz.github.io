HloModule m

fused {
  p = f32[4] parameter(0)
  ROOT n = f32[4] negate(p)
}

wrapper {
  p = f32[4] parameter(0)
  ROOT f = f32[4] fusion(p), kind=kLoop, calls=fused
}

ENTRY e {
  a = f32[4] parameter(0)
  st = ((f32[4]), f32[4], u32[]) async-start(a), calls=fused
  ROOT d = f32[4] async-done(st)
}
