HloModule m

async_computation {
  p0 = f32[4] parameter(0)
  p1 = f32[4] parameter(1)
  ROOT add = f32[4] add(p0, p1)
}

ENTRY e {
  x = f32[4] parameter(0)
  y = f32[4] parameter(1)
  s = ((), f32[4], s32[]) async-start(), calls=async_computation
  u = ((f32[4], f32[4]), f32[4], s32[]) async-update(s, x, y)
  ROOT d = f32[4] async-done(u)
}
