HloModule FoldDotTranspose

ENTRY %entry_computation {
  %x = f32[3,4] parameter(0)
  %y = f32[3,4,6,7] parameter(1)
  %transpose = f32[3,4,7,6] transpose(y), dimensions={0,1,3,2}
  %dot = f32[3,4,7,6] dot(x, transpose), lhs_batch_dims={0,1}, rhs_batch_dims={0,1}, lhs_contracting_dims={}, rhs_contracting_dims={}
  %p0 = f16[2048,1024] parameter(2)
  %p1 = f16[2048,1024] parameter(3)
  %sum = f16[2048,1024] add(%p0, %p1)
  %x.d = f32[3,4] parameter(4)
  %transpose.d = f32[3,4,7,6] transpose(%y), dimensions={0,1,3,2}
  %dot.d = f32[3,4,7,6] dot(%x.d, %transpose.d), lhs_batch_dims={0,1}, rhs_batch_dims={0,1}, lhs_contracting_dims={}, rhs_contracting_dims={}
  %root = (f16[2048,1024], f16[2048,1024], f16[2048,1024]) tuple(%p0, %sum, %p1)
  %ffl.root = ((f16[2048,1024], f16[2048,1024], f16[2048,1024]), f32[3,4,7,6]) tuple(%root, %dot.d)
  ROOT %ffl.root.1 = (f32[3,4,7,6], (f16[2048,1024], f16[2048,1024], f16[2048,1024]), f32[3,4,7,6]) tuple(%dot, %root, %dot.d)
}
