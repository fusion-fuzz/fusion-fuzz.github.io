HloModule test, num_partitions=4

%fused_computation (param_0: f32[8]) -> f32[9] {
  %param_0 = f32[8]{0} parameter(0)
  %cst = f32[1]{0} constant({4.0})
  %concat = f32[9]{0} concatenate(%param_0, %cst), dimensions={0}
  ROOT %slice = f32[9]{0} slice(%concat), slice={[0:9]}
}

%fused_computation.d (param_0: f32[8]) -> f32[9] {
  %param_0 = f32[8]{0} parameter(0)
  %cst = f32[1]{0} constant({4.0})
  %concat = f32[9]{0} concatenate(%param_0, %cst), dimensions={0}
  ROOT %slice = f32[9]{0} slice(%concat), slice={[0:9]}
}

ENTRY %main {
  %c0 = f32[] constant(0)
  %param_0 = f32[8]{0} parameter(0)
  %fusion = f32[9]{0} fusion(%param_0), kind=kCustom, calls=%fused_computation, backend_config={ "operation_queue_id":"0", "fusion_backend_config":{ "kind":"__triton", "block_level_fusion_config":{ "num_warps":"4", "output_tiles":[{"sizes":["2"]}], "num_ctas":1, "num_stages":1, "is_tma_allowed":true, "is_warp_specialization_allowed":false, "waves_per_eu":0 } }, "force_earliest_schedule":false, "reification_cost":[], "device_type":"DEVICE_TYPE_INVALID" }
  %c1 = f32[] constant(1)
  %b0 = f32[512,34,5]{2,1,0} broadcast(c0), dimensions={}, sharding={devices=[1,2,2]<=[2,2]T(1,0)}
  %pad = f32[512,46,5]{2,1,0} pad(b0, c1), padding=0_0x6_6x0_0, sharding={devices=[1,2,2]<=[2,2]T(1,0)}
  %ffl.root = (f32[512,46,5]{2,1,0}, f32[9]{0}) tuple(%pad, %fusion)
  %param_0.d = f32[8]{0} parameter(1)
  %fusion.d = f32[9]{0} fusion(%c0), kind=kCustom, calls=%fused_computation.d, backend_config={ "operation_queue_id":"0", "fusion_backend_config":{ "kind":"__triton", "block_level_fusion_config":{ "num_warps":"4", "output_tiles":[{"sizes":["2"]}], "num_ctas":1, "num_stages":1, "is_tma_allowed":true, "is_warp_specialization_allowed":false, "waves_per_eu":0 } }, "force_earliest_schedule":false, "reification_cost":[], "device_type":"DEVICE_TYPE_INVALID" }
  ROOT %ffl.root.1 = (f32[512,46,5]{2,1,0}, f32[9]{0}, f32[9]{0}) tuple(%pad, %fusion, %fusion.d)
}
