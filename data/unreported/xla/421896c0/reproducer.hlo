  %c0 = f32[] call(%p0), to_apply=%call_a
  %c1 = f32[] call(%p1), to_apply=%call_b
  %t = (f32[], f32[]) tuple(%c0, %c1)
  %ffl.root = (f32[1,4096], (f32[], f32[])) tuple(%scatter.48, %t)
  %p0.d = f32[16] parameter(5)
