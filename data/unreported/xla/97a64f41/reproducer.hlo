HloModule StringifyGather

%dot {
  %lhs = f32[2,8192,512] parameter(0)
  %rhs = f32[2,512,512] parameter(1)
  ROOT %dot = f32[2,8192,512] dot(lhs, rhs), lhs_batch_dims={0}, rhs_batch_dims={0}, lhs_contracting_dims={2}, rhs_contracting_dims={1}
}

%dot.d {
  %lhs = f32[2,8192,512] parameter(0)
  %rhs = f32[2,512,512] parameter(1)
  ROOT %dot = f32[2,8192,512] dot(lhs, rhs), lhs_batch_dims={0}, rhs_batch_dims={0}, lhs_contracting_dims={2}, rhs_contracting_dims={1}
}

ENTRY %Gather {
  %input_tensor = f32[2,3,4,512]{3,2,1,0} parameter(0)
  %start_indices = s64[3,2,1]{2,1,0} parameter(1)
  %p0 = f32[2,8192,512] parameter(2)
  %p1 = f32[2,512,512] parameter(3)
  %fusion = f32[2,8192,512] fusion(%p0, %p1), kind=kCustom, calls=%dot.d, backend_config={ "fusion_backend_config": { "kind":"__triton_gemm", "triton_gemm_config": { "block_m":"64", "block_n":"256", "block_k":"32", "num_stages":"5", "num_warps":"4", "num_ctas":"3" } } }
  %gather = f32[3,2,5]{2,1,0} gather(f32[2,3,4,512]{3,2,1,0} %input_tensor, s64[3,2,1]{2,1,0} %start_indices), offset_dims={2}, collapsed_slice_dims={2}, start_index_map={2}, operand_batching_dims={0,1}, start_indices_batching_dims={1,0}, index_vector_dim=2, slice_sizes={1,1,1,5}, indices_are_sorted=true
  ROOT %ffl.root = (f32[3,2,5]{2,1,0}, f32[2,8192,512]) tuple(%gather, %fusion)
}
