HloModule main

ENTRY %main.6 {
  %Arg_0.1 = f32[4] parameter(0)
  %Arg_1.2 = f32[4] parameter(1)
  %add.3 = f32[4] add(f32[4] %Arg_0.1, f32[4] %Arg_1.2)
  %dot.4 = f32[] dot(f32[4] %add.3, f32[4] %Arg_1.2), lhs_contracting_dims={0}, rhs_contracting_dims={0}
  %tuple.5 = (f32[]) tuple(f32[] %dot.4)
  %neg = f32[] negate(%dot.4)
  %neg.d = f32[] negate(%neg)
  %tok0.d = token[] after-all(), control-predecessors={%neg.d}
  %tok1.d = token[] after-all(), control-predecessors={%tok0.d}
  %tok0 = token[] after-all(), control-predecessors={%neg}
  %tok1 = token[] after-all(), control-predecessors={%tok0}
  %ffl.root = ((f32[]), token[]) tuple(%tuple.5, %tok1)
  ROOT %ffl.root.1 = ((f32[]), token[], token[]) tuple(%tuple.5, %tok1, %tok1.d)
}
