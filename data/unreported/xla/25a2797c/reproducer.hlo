ENTRY %main {
  %x = f8e4m3fn[] parameter(0)
  %root = bf16[] convert(x)
  %param_0 = f32[] parameter(1)
  %fusion = s32[] fusion(%param_0), kind=kLoop, calls=%fused_computation
  %tuple = () tuple()
  %fusion.d = s32[] fusion(%param_0), kind=kLoop, calls=%fused_computation.d
  %tuple.d = () tuple()
