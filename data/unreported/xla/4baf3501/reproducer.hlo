HloModule m

ENTRY %e {
  %p0 = f16[2,18] parameter(0)
  %p1 = f16[256,2] parameter(1)
  %d = f16[18,256] dot(p0, p1), lhs_contracting_dims={0}, rhs_contracting_dims={1}
  %p2 = f16[] parameter(2)
  %b = f16[18,256] broadcast(f16[] p2)
  %a = f16[18,256] add(d, b)
  %lhs = f8e4m3fn[1024,512]{1,0} parameter(3), sharding={devices=[4,2]<=[8]}
  %lhs_scale = f8e8m0fnu[1024,16]{1,0} parameter(4), sharding={devices=[4,2]<=[8]}
  %rhs = f8e4m3fn[128,512]{1,0} parameter(5), sharding={devices=[2,4]<=[8]}
  %rhs_scale.d = f8e8m0fnu[128,16] parameter(7), sharding={devices=[2,4]<=[8]}
  %block_scaled_dot.d = f32[1024,128]{1,0} custom-call(%lhs, %rhs, %lhs_scale, %rhs_scale.d), custom_call_target="__op$block_scaled_dot", sharding={devices=[4,2]<=[8]}
  %rhs_scale = f8e8m0fnu[128,16] parameter(6), sharding={devices=[2,4]<=[8]}
  %block_scaled_dot = f32[1024,128]{1,0} custom-call(%lhs, %rhs, %d, %rhs_scale), custom_call_target="__op$block_scaled_dot", sharding={devices=[4,2]<=[8]}
  %ffl.root = (f16[18,256], f32[1024,128]{1,0}) tuple(%a, %block_scaled_dot)
  ROOT %ffl.root.1 = (f16[18,256], f32[1024,128]{1,0}, f32[1024,128]{1,0}) tuple(%a, %block_scaled_dot, %block_scaled_dot.d)
}
