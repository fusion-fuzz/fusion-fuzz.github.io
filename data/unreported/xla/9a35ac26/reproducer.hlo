HloModule test

ENTRY %test {
  %a = c64[2,2] parameter(0)
  %b = c64[2] parameter(1)
  %cd = c64[2] dot(a, b), lhs_contracting_dims={1}, rhs_contracting_dims={0}
  %c = f64[2,2] parameter(2)
  %d = f64[2] parameter(3)
  %dd = f64[2] dot(c, d), lhs_contracting_dims={1}, rhs_contracting_dims={0}
  %p0 = f32[] parameter(4)
  %p1 = f32[] parameter(5)
  %result = pred[] compare(%p0, %p1), direction=GT, order=TOTAL
  %tuple = (c64[2], f64[2]) tuple(cd, dd)
  %ffl.root = ((c64[2], f64[2]), pred[]) tuple(%tuple, %result)
  %p0.d = f32[] parameter(6)
  %p1.d = f32[] parameter(7)
  %result.d = pred[] compare(%tuple, %p1.d), direction=GT, order=TOTAL
  ROOT %ffl.root.1 = ((c64[2], f64[2]), pred[], pred[]) tuple(%tuple, %result, %result.d)
}
