HloModule TestModule

%fused_computation (param_0: f32[4,5,128,256]) -> f32[4,5,128,256] {
  %param_0 = f32[4,5,128,256] parameter(0)
  ROOT %copy = f32[4,5,128,256] copy(param_0)
}

ENTRY %main {
  %param0 = f32[10] parameter(0)
  %param1 = f32[20] parameter(1)
  %param2 = f32[30] parameter(2)
  %tuple_result = (f32[10], f32[20]) tuple(param0, param1)
  %param_0 = f32[4,5,128,256] parameter(3)
  %param_1 = f32[] parameter(4)
  %copy = f32[] copy(%param_1)
  %fusion = f32[4,5,128,256] fusion(%param_0, %param1), kind=kOutput, calls=%fused_computation
  ROOT %ffl.root = ((f32[10], f32[20]), f32[4,5,128,256]) tuple(%tuple_result, %fusion)
}
