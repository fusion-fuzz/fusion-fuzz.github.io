HloModule my_module

%other_computation {
  %param_0 = f32[2048] parameter(0)
  %param_1 = f32[2048] parameter(1)
  ROOT %tuple = (f32[2048], f32[2048]) tuple(param_0, param_1)
}

%region_0.1 {
  %reduce_sum.4 = f32[] parameter(1)
  %reduce_sum.3 = f32[] parameter(0)
  ROOT %reduce_sum.5 = f32[] add(reduce_sum.3, reduce_sum.4)
}

%region_0.1.d {
  %reduce_sum.4 = f32[] parameter(1)
  %reduce_sum.3 = f32[] parameter(0)
  ROOT %reduce_sum.5 = f32[] add(reduce_sum.3, reduce_sum.4)
}

%region_0.1.d.1 {
  %reduce_sum.4 = f32[] parameter(1)
  %reduce_sum.3 = f32[] parameter(0)
  ROOT %reduce_sum.5 = f32[] add(reduce_sum.3, reduce_sum.4)
}

ENTRY %main {
  %data_param = f32[2048] parameter(0)
  %other_param = f32[2048] parameter(1)
  %offload_custom_call = f32[2048] custom-call(data_param), custom_call_target="MoveToHost"
  %call = (f32[2048], f32[2048]) call(offload_custom_call, other_param), to_apply=other_computation
  %gte_0 = f32[2048] get-tuple-element(call), index=0
  %gte_1 = f32[2048] get-tuple-element(call), index=1
  %load_custom_call = f32[2048] custom-call(gte_0), custom_call_target="MoveToDevice"
  %param_0.4 = f32[512,1024] parameter(2)
  %broadcast_in_dim.0 = f32[16,8,1024,512] broadcast(%data_param), dimensions={3,2}
  %constant.0 = f32[] constant(0)
  %reduce_sum.0 = f32[16,8] reduce(%broadcast_in_dim.0, %constant.0), dimensions={3,2}, to_apply=%region_0.1
  %ffl.root = (f32[2048], f32[16,8]) tuple(%load_custom_call, %reduce_sum.0)
  %ffl.call = f32[] call(%constant.0, %constant.0), to_apply=%region_0.1.d
  %ffl.root.1 = (f32[2048], f32[16,8], f32[]) tuple(%load_custom_call, %reduce_sum.0, %ffl.call)
  %broadcast_in_dim.0.d = f32[16,8,1024,512] broadcast(%param_0.4), dimensions={3,2}
  %constant.0.d = f32[] constant(0)
  %reduce_sum.0.d = f32[16,8] reduce(%broadcast_in_dim.0.d, %constant.0.d), dimensions={3,2}, to_apply=%region_0.1.d.1
  ROOT %ffl.root.2 = (f32[2048], f32[16,8], f32[], f32[16,8]) tuple(%load_custom_call, %reduce_sum.0, %ffl.call, %reduce_sum.0.d)
}
