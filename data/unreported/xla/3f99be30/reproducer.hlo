  %indices.d = s32[5,1] parameter(11)
  %update0.d = f32[5,4,1] parameter(12)
  %update1.d = f32[5,4,1] parameter(13)
  %scatter.d = (f32[4,10], f32[4,10]) scatter(%operand0.d, %reduce-scatter-start.1, %indices.d, %update0.d, %update1.d), to_apply=%scatter_computation.d, update_window_dims={1,2}, inserted_window_dims={}, scatter_dims_to_operand_dims={1}, index_vector_dim=1
  ROOT %ffl.root.1 = ((f32[16,256,256]{2,1,0}, f32[128,2048,2048]{2,1,0}, f32[256,2048,2048]{2,1,0}), (f32[4,10], f32[4,10]), (f32[4,10], f32[4,10])) tuple(%tuple.2, %scatter, %scatter.d)
