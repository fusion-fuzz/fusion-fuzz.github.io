HloModule module, num_partitions=8

%region_20.995 {
  %Arg_1.997 = f32[] parameter(1)
  %Arg_0.996 = f32[] parameter(0)
  ROOT %add.589 = f32[] add(Arg_0.996, Arg_1.997)
}

%scatter_computation {
  %p0 = f32[] parameter(0)
  %p1 = f32[] parameter(1)
  %p2 = f32[] parameter(2)
  %p3 = f32[] parameter(3)
  %add0 = f32[] add(p0, p2)
  %add1 = f32[] add(p1, p3) ROOT tuple = tuple(add0, add1)
}

%scatter_computation.d {
  %p0 = f32[] parameter(0)
  %p1 = f32[] parameter(1)
  %p2 = f32[] parameter(2)
  %p3 = f32[] parameter(3)
  %add0 = f32[] add(p0, p2)
  %add1 = f32[] add(p1, p3) ROOT tuple = tuple(add0, add1)
}

