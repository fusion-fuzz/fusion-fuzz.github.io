HloModule module, num_partitions=8

ENTRY %entry {
  %param = bf16[8,4,8,128] parameter(0)
  %constant = f32[1]{0} constant({12345})
  %custom-call = f32[1,2,3]{0,2,1} custom-call(f32[1]{0} %constant), custom_call_target="foo\"bar", literal=s32[2]{0} {1, 2}
  %all-gather.d = bf16[8,32,8,128] all-gather(%param), dimensions={1}, replica_groups={{0,1,2,3,4,5,6,7}}, channel_id=1, use_global_device_ids=true
  %convert.d = f8e4m3fn[8,32,8,128] convert(%constant)
  %ffl.root = (f32[1,2,3]{0,2,1}, f8e4m3fn[8,32,8,128]) tuple(%custom-call, %convert.d)
  %all-gather = bf16[8,32,8,128] all-gather(param), dimensions={1}, replica_groups={{0,1,2,3,4,5,6,7}}, channel_id=1, use_global_device_ids=true
  %convert = f8e4m3fn[8,32,8,128] convert(all-gather)
  ROOT %ffl.root.1 = (f8e4m3fn[8,32,8,128], f32[1,2,3]{0,2,1}, f8e4m3fn[8,32,8,128]) tuple(%convert, %custom-call, %convert.d)
}
