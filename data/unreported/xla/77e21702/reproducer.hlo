HloModule nested_fusion_module

%fused_comp_0 {
  %p0.2 = f32[10] parameter(0)
  %mul = f32[10] multiply(p0.2, p0.2)
  ROOT %add.1 = f32[10] add(mul, p0.2)
}

%fused_comp_1 {
  %p0.1 = f32[10] parameter(0)
  ROOT %inner_fusion = f32[10] fusion(p0.1), kind=kLoop, calls=fused_comp_0
}

ENTRY %main {
  %p0 = f32[10] parameter(0)
  %outer_fusion = f32[10] fusion(p0), kind=kLoop, calls=fused_comp_1
  %a = bf16[17,96,120] parameter(1)
  %b = bf16[17,96,120] parameter(2)
  %cbrt_a = bf16[17,96,120] cbrt(%a)
  %cbrt_b = bf16[17,96,120] cbrt(%b)
  %max = bf16[17,96,120] maximum(%cbrt_a, %cbrt_b)
  %ffl.root = (f32[10], bf16[17,96,120]) tuple(%outer_fusion, %max)
  %a.d = bf16[17,96,120] parameter(3)
  %b.d = bf16[17,96,120] parameter(4)
  %cbrt_a.d = bf16[17,96,120] cbrt(%a.d)
  %cbrt_b.d = bf16[17,96,120] cbrt(%b.d)
  %max.d = bf16[17,96,120] maximum(%b, %cbrt_b.d)
  ROOT %ffl.root.1 = (f32[10], bf16[17,96,120], bf16[17,96,120]) tuple(%outer_fusion, %max, %max.d)
}
