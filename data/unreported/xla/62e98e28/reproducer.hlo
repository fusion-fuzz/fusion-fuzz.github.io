HloModule TestModule

%compare {
  %lhs = f32[] parameter(0)
  %rhs = f32[] parameter(1)
  ROOT %lt = pred[] compare(%lhs, %rhs), direction=LT
}

%innermost_computation (p: f32[8,128]) -> f32[8,128] {
  %p = f32[8,128] parameter(0)
  ROOT %sqrt = f32[8,128] sqrt(%p)
}

%outer_computation (p_outer: f32[8,128]) -> f32[8,128] {
  %p_outer = f32[8,128] parameter(0)
  ROOT %inner_fusion = f32[8,128] fusion(%p_outer), kind=kLoop, calls=%innermost_computation
}

ENTRY %main {
  %input = f32[100000000000000] parameter(0)
  %param_0 = f32[8,128] parameter(1)
  %outer_fusion = f32[8,128] fusion(%param_0), kind=kOutput, calls=%outer_computation
  %sort = f32[100000000000000] sort(%input), dimensions={0}, to_apply=%compare
  ROOT %ffl.root = (f32[100000000000000], f32[8,128]) tuple(%sort, %outer_fusion)
}
