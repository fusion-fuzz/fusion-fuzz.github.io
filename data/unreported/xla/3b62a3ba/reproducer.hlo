HloModule m, num_partitions=8

add {
  lhs = s32[] parameter(0)
  rhs = s32[] parameter(1)
  ROOT add = s32[] add(lhs, rhs)
}

ENTRY main {
  x = s32[8] parameter(0), sharding={devices=[4,2]<=[8] last_tile_dim_replicate}
  local = s32[2] custom-call(x), custom_call_target="SPMDFullToShardShape", sharding={devices=[1,4,2]<=[8] last_tile_dims={manual, replicated}}
  idx = s32[2] copy(local), sharding={devices=[2,4]<=[4,2]T(1,0) last_tile_dims={manual}}
  operand = s32[3,3] parameter(1)
  updates = s32[2,3] parameter(2)
  ROOT scatter = s32[3,3] scatter(operand, idx, updates), to_apply=add, update_window_dims={1}, inserted_window_dims={0}, scatter_dims_to_operand_dims={0}, index_vector_dim=1
}
