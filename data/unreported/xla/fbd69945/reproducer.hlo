HloModule m

ENTRY %test {
  %p0 = s32[1] parameter(0)
  %p1 = s32[1] parameter(1)
  %p2 = s32[1] parameter(2)
  %concat = s32[3] concatenate(p0, p1, p2), dimensions={0}
  %slice = s32[1] slice(concat), slice={[1:2:2]}
  %param0 = f32[12] parameter(3), sharding={devices=[4]<=[4]}
  %custom-call = f32[12] custom-call(%concat), custom_call_target="_SPMDInternalOp_RotateRight", backend_config="dimension=0,amount=2", sharding={devices=[4]<=[4]}
  ROOT %ffl.root = (s32[1], f32[12]) tuple(%slice, %custom-call)
}
