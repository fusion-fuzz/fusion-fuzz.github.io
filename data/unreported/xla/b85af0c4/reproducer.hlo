HloModule DotFuncModule

ENTRY %DotFunc {
  %x = f32[100,30,3] parameter(0)
  %y = f32[100,3,3] parameter(1)
  %p0 = f32[4,511,432]{2,1,0} parameter(2)
  %p1 = s32[] parameter(3)
  %p2 = f32[432,337]{1,0:T(8,128)} parameter(4)
  %p0_dynamic = f32[<=4,511,432] set-dimension-size(%p0, %p1), dimensions={0}
  %reshape.4179 = f32[<=2044,432]{1,0} reshape(%p0_dynamic)
  %dot.4180 = f32[<=2044,337]{1,0} dot(%reshape.4179, %p2), lhs_contracting_dims={1}, rhs_contracting_dims={0}
  %transpose.4181 = f32[<=2044,337]{1,0} transpose(%dot.4180), dimensions={0,1}
  %reshape.4183 = f32[<=4,511,337]{2,1,0} reshape(%transpose.4181)
  %dot = f32[100,30,3] dot(x, y), lhs_contracting_dims={2}, rhs_contracting_dims={1}, lhs_batch_dims={0}, rhs_batch_dims={0}
  %ffl.root = (f32[100,30,3], f32[<=4,511,337]{2,1,0}) tuple(%dot, %reshape.4183)
  %p1.d = s32[] parameter(5)
  %p2.d = f32[432,337]{1,0:T(8,128)} parameter(6)
  %p0_dynamic.d = f32[<=4,511,432] set-dimension-size(%p0, %p1.d), dimensions={0}
  %reshape.4179.d = f32[<=2044,432]{1,0} reshape(%p0_dynamic.d)
  %dot.4180.d = f32[<=2044,337]{1,0} dot(%reshape.4179.d, %p2.d), lhs_contracting_dims={1}, rhs_contracting_dims={0}
  %transpose.4181.d = f32[<=2044,337]{1,0} transpose(%dot.4180.d), dimensions={0,1}
  %reshape.4183.d = f32[<=4,511,337]{2,1,0} reshape(%transpose.4181.d)
  ROOT %ffl.root.1 = (f32[100,30,3], f32[<=4,511,337]{2,1,0}, f32[<=4,511,337]{2,1,0}) tuple(%dot, %reshape.4183, %reshape.4183.d)
}
