HloModule test, num_partitions=4

%dsf_computation (param_0: f32[2,2,2], param_1: s32[], param_2: s32[], param_3: s32[]) -> f32[1,2,2] {
  %param_0 = f32[2,2,2]{2,1,0} parameter(0)
  %param_1 = s32[] parameter(1)
  %param_2 = s32[] parameter(2)
  %param_3 = s32[] parameter(3)
  ROOT %dynamic-slice = f32[1,2,2]{2,1,0} dynamic-slice(%param_0, %param_1, %param_2, %param_3), dynamic_slice_sizes={1,2,2}, backend_config={"dynamic_slice_config":{ "linear":{"byte_offset":"0","byte_stride":"0"}}}
}

%async_computation (param_0: f32[2,2,2], param_1: s32[], param_2: s32[], param_3: s32[]) -> f32[1,2,2] {
  %param_0 = f32[2,2,2]{2,1,0} parameter(0)
  %param_1 = s32[] parameter(1)
  %param_2 = s32[] parameter(2)
  %param_3 = s32[] parameter(3)
  ROOT %dynamic-slice-fusion = f32[1,2,2]{2,1,0} fusion(%param_0, %param_1, %param_2, %param_3), kind=kLoop, calls=%dsf_computation
}

%condition {
  %p = (s32[]) parameter(0)
  %cond = s32[] get-tuple-element(p), index=0
  %trip_count = s32[] constant(7)
  %done = pred[] compare(cond, trip_count), direction=LT
}

%body {
  %p = (s32[]) parameter(0)
  %cond = s32[] get-tuple-element(p), index=0
  %one = s32[] constant(1)
  %cond_plus_1 = s32[] add(cond, one)
  %t = (s32[]) tuple(cond_plus_1)
}

%dsf_computation.d (param_0: f32[2,2,2], param_1: s32[], param_2: s32[], param_3: s32[]) -> f32[1,2,2] {
  %param_0 = f32[2,2,2]{2,1,0} parameter(0)
  %param_1 = s32[] parameter(1)
  %param_2 = s32[] parameter(2)
  %param_3 = s32[] parameter(3)
  ROOT %dynamic-slice = f32[1,2,2]{2,1,0} dynamic-slice(%param_0, %param_1, %param_2, %param_3), dynamic_slice_sizes={1,2,2}, backend_config={"dynamic_slice_config":{ "linear":{"byte_offset":"0","byte_stride":"0"}}}
}

%async_computation.d (param_0: f32[2,2,2], param_1: s32[], param_2: s32[], param_3: s32[]) -> f32[1,2,2] {
  %param_0 = f32[2,2,2]{2,1,0} parameter(0)
  %param_1 = s32[] parameter(1)
  %param_2 = s32[] parameter(2)
  %param_3 = s32[] parameter(3)
  ROOT %dynamic-slice-fusion = f32[1,2,2]{2,1,0} fusion(%param_0, %param_1, %param_2, %param_3), kind=kLoop, calls=%dsf_computation.d
}

%dsf_computation.d.d (param_0: f32[2,2,2], param_1: s32[], param_2: s32[], param_3: s32[]) -> f32[1,2,2] {
  %param_0 = f32[2,2,2]{2,1,0} parameter(0)
  %param_1 = s32[] parameter(1)
  %param_2 = s32[] parameter(2)
  %param_3 = s32[] parameter(3)
  ROOT %dynamic-slice = f32[1,2,2]{2,1,0} dynamic-slice(%param_0, %param_1, %param_2, %param_3), dynamic_slice_sizes={1,2,2}, backend_config={"dynamic_slice_config":{ "linear":{"byte_offset":"0","byte_stride":"0"}}}
}

%async_computation.d.d (param_0: f32[2,2,2], param_1: s32[], param_2: s32[], param_3: s32[]) -> f32[1,2,2] {
  %param_0 = f32[2,2,2]{2,1,0} parameter(0)
  %param_1 = s32[] parameter(1)
  %param_2 = s32[] parameter(2)
  %param_3 = s32[] parameter(3)
  ROOT %dynamic-slice-fusion = f32[1,2,2]{2,1,0} fusion(%param_0, %param_1, %param_2, %param_3), kind=kLoop, calls=%dsf_computation.d.d
}

ENTRY %main {
  %p0 = f32[1,2,2]{2,1,0} parameter(0)
  %p1 = f32[2,2,2]{2,1,0} parameter(1)
  %c0 = s32[] constant(0)
  %p = s32[] constant(0)
  %t = (s32[]) tuple(%p)
  %w = (s32[]) while(%t), condition=%condition, body=%body, backend_config={"known_trip_count":{"n":"7"}}
  %ffl.call = f32[1,2,2]{2,1,0} call(%t, %t, %p, %p), to_apply=%async_computation.d
  %ffl.root = ((s32[]), f32[1,2,2]{2,1,0}) tuple(%w, %ffl.call)
  %c0.d = s32[] constant(0)
  %dynamic-slice-start.d = ((f32[2,2,2]{2,1,0}, s32[], s32[], s32[]), f32[1,2,2]{2,1,0}, u32[]) async-start(%p1, %c0.d, %c0.d, %c0.d), calls=%async_computation.d.d
  %dynamic-slice-done.d = f32[1,2,2]{2,1,0} async-done(%dynamic-slice-start.d)
  %add.d = f32[1,2,2]{2,1,0} add(%ffl.call, %ffl.call)
  %tuple.d = (f32[1,2,2]{2,1,0}, f32[1,2,2]{2,1,0}) tuple(%dynamic-slice-done.d, %add.d)
  %ffl.root.1 = ((s32[]), f32[1,2,2]{2,1,0}, (f32[1,2,2]{2,1,0}, f32[1,2,2]{2,1,0})) tuple(%w, %ffl.call, %tuple.d)
  %dynamic-slice-start = ((f32[2,2,2]{2,1,0}, s32[], s32[], s32[]), f32[1,2,2]{2,1,0}, u32[]) async-start(%p1, %c0, %c0, %c0), calls=%async_computation
  %dynamic-slice-done = f32[1,2,2]{2,1,0} async-done(%dynamic-slice-start)
  %add = f32[1,2,2]{2,1,0} add(p0, p0)
  %tuple = (f32[1,2,2]{2,1,0}, f32[1,2,2]{2,1,0}) tuple(%dynamic-slice-done, %add)
  ROOT %ffl.root.2 = ((f32[1,2,2]{2,1,0}, f32[1,2,2]{2,1,0}), (s32[]), f32[1,2,2]{2,1,0}, (f32[1,2,2]{2,1,0}, f32[1,2,2]{2,1,0})) tuple(%tuple, %w, %ffl.call, %tuple.d)
}
