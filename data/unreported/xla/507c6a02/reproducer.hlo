HloModule test

%async_computation {
  %p0 = f32[4] parameter(0)
  ROOT %negate = f32[4] negate(p0)
}

%sum {
  %x = f32[] parameter(0)
  %y = f32[] parameter(1)
  ROOT %add = f32[] add(x, y)
}

%async_computation.d {
  %p0 = f32[4] parameter(0)
  ROOT %negate = f32[4] negate(p0)
}

%async_computation.d.d {
  %p0 = f32[4] parameter(0)
  ROOT %negate = f32[4] negate(p0)
}

ENTRY %entry {
  %x = f32[4] constant({1.0, 2.0, 3.0, 4.0})
  %async-start = ((), f32[4], s32[]) async-start(), calls=async_computation, async_execution_thread="thread"
  %async-update = ((f32[4]), f32[4], s32[]) async-update(async-start, x)
  %async-done = f32[4] async-done(async-update)
  %ffl.call = f32[4] call(%x), to_apply=%async_computation.d
  ROOT %ffl.root = (f32[4], f32[4]) tuple(%async-done, %ffl.call)
}
