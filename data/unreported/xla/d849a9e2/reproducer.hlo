HloModule pjit__unnamed_wrapped_function_, num_partitions=2

ENTRY %entry {
  %input = bf16[2] constant({2., 4.})
  %input_f32 = f32[2] convert(input)
  %scale = f32[] constant(2.)
  %scale_bcast = f32[2] broadcast(scale), dimensions={}
  %input_scaled = f32[2] multiply(input_f32, scale_bcast)
  %all-to-all = f32[2] all-to-all(input_scaled), channel_id=1, replica_groups={{0,1}}, dimensions={0}
  %param = s32[3, 4, 4] parameter(0)
  %two = s32[] constant(2)
  %param_dynamic = s32[<=3, 4, 4] set-dimension-size(%param, %two), dimensions={0}
  %three = s32[] constant(3)
  %param_dynamic1 = s32[<=3, <=4, 4] set-dimension-size(%param_dynamic, %three), dimensions={1}
  %param_dynamic2 = s32[<=3, <=4, <=4] set-dimension-size(%param_dynamic1, %three), dimensions={2}
  %six = s32[] constant(6)
  %reshaped = s32[<=6, <=8] dynamic-reshape(%param_dynamic2, %three, %six)
  %input.d = bf16[2] constant({2., 4.})
  %input_f32.d = f32[2] convert(%input.d)
  %scale.d = f32[] constant(2.)
  %scale_bcast.d = f32[2] broadcast(%scale.d), dimensions={}
  %input_scaled.d = f32[2] multiply(%input_f32.d, %six)
  %all-to-all.d = f32[2] all-to-all(%input_scaled.d), channel_id=1, replica_groups={{0,1}}, dimensions={0}
  %ffl.root = (s32[<=6, <=8], f32[2]) tuple(%reshaped, %all-to-all.d)
  ROOT %ffl.root.1 = (f32[2], s32[<=6, <=8], f32[2]) tuple(%all-to-all, %reshaped, %all-to-all.d)
}
