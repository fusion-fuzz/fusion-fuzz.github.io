HloModule m

ENTRY %test {
  %p0 = f32[<=512] parameter(0)
  %c = (f32[512], s32[]) custom-call(p0), custom_call_target="PadToStatic"
  %p1 = f32[<=512] parameter(1)
  %p0.d = f32[1,32] parameter(2)
  %abs0 = f32[1,32] abs(%p0.d)
  %c1.d = f32[] constant(-2.0)
  %broadcast = f32[1,32] broadcast(%c1.d), dimensions={}
  %power = f32[1,32] power(%abs0, %broadcast)
  %rsqrt = f32[1, 32] rsqrt(%power)
  %c.d = (f32[512], s32[]) custom-call(%p1), custom_call_target="PadToStatic"
  %c1.d.d = (f32[512], s32[]) custom-call(%p1), custom_call_target="PadToStatic"
  %gte0.d = f32[512] get-tuple-element(%c.d), index=0
  %gte1.d = s32[] get-tuple-element(%c1.d.d), index=1
  %c2.d = f32[<=512] custom-call(%power, %gte1.d), custom_call_target="SliceToDynamic"
  %ffl.root = (f32[1, 32], f32[<=512]) tuple(%rsqrt, %c2.d)
  %c1 = (f32[512], s32[]) custom-call(p1), custom_call_target="PadToStatic"
  %gte0 = f32[512] get-tuple-element(c), index=0
  %gte1 = s32[] get-tuple-element(c1), index=1
  %c2 = f32[<=512] custom-call(gte0, gte1), custom_call_target="SliceToDynamic"
  ROOT %ffl.root.1 = (f32[<=512], f32[1, 32], f32[<=512]) tuple(%c2, %rsqrt, %c2.d)
}
