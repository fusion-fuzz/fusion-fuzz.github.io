HloModule Test

%apply {
  %a = f32[] parameter(0)
  %b = f32[] parameter(1)
  ROOT %c = f32[] maximum(a, b)
}

%Body {
  %param = (s32[1], s32[2], s32[3]) parameter(0), origin={({"bp0"},{"bp1"},{"bp2"})}
  %a = s32[1] get-tuple-element(param), index=0
  %a.1 = s32[1] add(a, a)
  %b = s32[2] constant({1,1})
  %c = s32[3] constant({10,10,10})
  ROOT %tuple = (s32[1], s32[2], s32[3]) tuple(a.1, b, c), origin={({"br0"},{"br1"},{"br2"})}
}

%Cond {
  %param = (s32[1], s32[2], s32[3]) parameter(0), origin={({"cp0"},{"cp1"},{"cp2"})}
  %a = s32[1] get-tuple-element(param), index=0
  %b = s32[2] get-tuple-element(param), index=1
  %c = s32[3] get-tuple-element(param), index=2
  ROOT %cond = pred[] constant(true)
}

%apply.d {
  %a = f32[] parameter(0)
  %b = f32[] parameter(1)
  ROOT %c = f32[] maximum(a, b)
}

%apply.d.d {
  %a = f32[] parameter(0)
  %b = f32[] parameter(1)
  ROOT %c = f32[] maximum(a, b)
}

ENTRY %Test {
  %input = f8e4m3fn[1,128,6,6] parameter(0)
  %filter = f8e4m3fn[3,3,128,16] parameter(1)
  %input_scale = f32[] parameter(2)
  %input_scale_bcast = f32[1,16,6,6] broadcast(input_scale), dimensions={}
  %filter_scale = f32[] parameter(3)
  %filter_scale_bcast = f32[1,16,6,6] broadcast(filter_scale), dimensions={}
  %input_f32 = f32[1,128,6,6] convert(input)
  %filter_f32 = f32[3,3,128,16] convert(filter)
  %conv_a = f32[1,16,6,6] convolution(input_f32, filter_f32), window={size=3x3 pad=1_1x1_1}, dim_labels=bf01_01io->bf01, feature_group_count=1
  %conv_a_0 = f32[1,16,6,6] multiply(conv_a, input_scale_bcast)
  %conv_a_1 = f32[1,16,6,6] multiply(conv_a_0, filter_scale_bcast)
  %z_scale = f32[] parameter(4)
  %z_scale_bcast = f32[1,16,6,6] broadcast(z_scale), dimensions={}
  %conv_a_scaled = f32[1,16,6,6] multiply(conv_a_1, z_scale_bcast)
  %abs_conv_a = f32[1,16,6,6] abs(conv_a_1)
  %c0 = f32[] constant(-inf)
  %amax = f32[] reduce(abs_conv_a, c0), dimensions={0,1,2,3}, to_apply=apply
  %amax_bcast = f32[1,16,6,6] broadcast(amax), dimensions={}
  %conv_a_scaled_amax = f32[1,16,6,6] add(conv_a_scaled, amax_bcast)
  %c1 = f32[] constant(-448.)
  %c1_bcast = f32[1,16,6,6] broadcast(c1), dimensions={}
  %c2 = f32[] constant(448.)
  %c2_bcast = f32[1,16,6,6] broadcast(c2), dimensions={}
  %conv_a_clamped = f32[1,16,6,6] clamp(c1_bcast, conv_a_scaled_amax, c2_bcast)
  %conv_a_clamped_f8 = f8e4m3fn[1,16,6,6] convert(conv_a_clamped)
  %conv_f8 = (f8e4m3fn[1,16,6,6], f32[]) tuple(conv_a_clamped_f8, amax)
  %a = s32[1] constant({0})
  %input.d = f8e4m3fn[1,128,6,6] parameter(5)
  %filter.d = f8e4m3fn[3,3,128,16] parameter(6)
  %input_scale.d = f32[] parameter(7)
  %input_scale_bcast.d = f32[1,16,6,6] broadcast(%input_scale.d), dimensions={}
  %filter_scale.d = f32[] parameter(8)
  %filter_scale_bcast.d = f32[1,16,6,6] broadcast(%filter_scale.d), dimensions={}
  %input_f32.d = f32[1,128,6,6] convert(%input.d)
  %filter_f32.d = f32[3,3,128,16] convert(%filter.d)
  %conv_a.d = f32[1,16,6,6] convolution(%input_f32.d, %filter_f32.d), window={size=3x3 pad=1_1x1_1}, dim_labels=bf01_01io->bf01, feature_group_count=1
  %conv_a_0.d = f32[1,16,6,6] multiply(%conv_a.d, %input_scale_bcast.d)
  %conv_a_1.d = f32[1,16,6,6] multiply(%conv_a_0.d, %filter_scale_bcast.d)
  %z_scale.d = f32[] parameter(9)
  %z_scale_bcast.d = f32[1,16,6,6] broadcast(%z_scale.d), dimensions={}
  %conv_a_scaled.d = f32[1,16,6,6] multiply(%conv_a_1.d, %z_scale_bcast.d)
  %abs_conv_a.d = f32[1,16,6,6] abs(%conv_a_1.d)
  %c0.d = f32[] constant(-inf)
  %amax.d = f32[] reduce(%abs_conv_a.d, %c0.d), dimensions={0,1,2,3}, to_apply=%apply.d
  %amax_bcast.d = f32[1,16,6,6] broadcast(%amax.d), dimensions={}
  %conv_a_scaled_amax.d = f32[1,16,6,6] add(%conv_a_scaled.d, %amax_bcast.d)
  %c1.d = f32[] constant(-448.)
  %c1_bcast.d = f32[1,16,6,6] broadcast(%c1.d), dimensions={}
  %c2.d = f32[] constant(448.)
  %c2_bcast.d = f32[1,16,6,6] broadcast(%c2.d), dimensions={}
  %conv_a_clamped.d = f32[1,16,6,6] clamp(%c1_bcast.d, %conv_a_scaled_amax, %c2_bcast.d)
  %conv_a_clamped_f8.d = f8e4m3fn[1,16,6,6] convert(%conv_a_clamped.d)
  %conv_f8.d = (f8e4m3fn[1,16,6,6], f32[]) tuple(%conv_a_clamped_f8.d, %amax.d)
  %b = s32[2] constant({1,1})
  %c = s32[3] constant({2,2,2})
  %init = (s32[1], s32[2], s32[3]) tuple(%a, %b, %c), origin={({"a"},{"b"},{"c"})}
  %while = (s32[1], s32[2], s32[3]) while(%init), condition=%Cond, body=%Body, origin={({"w0"},{"w1"},{"w2"})}
  %ffl.root = ((s32[1], s32[2], s32[3]), (f8e4m3fn[1,16,6,6], f32[])) tuple(%while, %conv_f8.d)
  %ffl.call = f32[] call(%input_scale.d, %input_scale.d), to_apply=%apply.d.d
  %ffl.root.1 = ((s32[1], s32[2], s32[3]), (f8e4m3fn[1,16,6,6], f32[]), f32[]) tuple(%while, %conv_f8.d, %ffl.call)
  ROOT %ffl.root.2 = ((f8e4m3fn[1,16,6,6], f32[]), (s32[1], s32[2], s32[3]), (f8e4m3fn[1,16,6,6], f32[]), f32[]) tuple(%conv_f8, %while, %conv_f8.d, %ffl.call)
}
