HloModule jit_f, allow_spmd_sharding_propagation_to_output={true}, num_partitions=8

ENTRY %main.12 {
  %Arg_0.1 = s32[8]{0} parameter(0), sharding={devices=[8]<=[8]}, metadata={op_name="x"}
  %copy.2 = s32[8]{0} copy(Arg_0.1), sharding={devices=[4,2]<=[8] last_tile_dim_replicate}
  %custom-call.3 = s32[2]{0} custom-call(copy.2), custom_call_target="SPMDFullToShardShape", sharding={devices=[1,4,2]<=[8] last_tile_dims={manual, replicated}}, backend_config="unspecified_dims=[0]"
  %copy.1 = s32[2]{0} copy(custom-call.3), sharding={devices=[2,4]<=[4,2]T(1,0) last_tile_dims={manual}}
  %multiply.0 = s32[2]{0} multiply(copy.1, copy.1), sharding={devices=[2,4]<=[4,2]T(1,0) last_tile_dims={manual}}
  %collective-permute.0 = s32[2]{0} collective-permute(multiply.0), channel_id=1, source_target_pairs={{0,6},{2,0},{4,2},{6,4},{1,7},{3,1},{5,3},{7,5}}, sharding={devices=[2,4]<=[4,2]T(1,0) last_tile_dims={manual}}
  %c1 = pred[] constant(true)
  %b2 = pred[32,1,768]{2,1,0} broadcast(pred[] %c1), dimensions={}
  %c3 = pred[] constant(false)
  %p4 = pred[4096,1,768]{2,1,0} pad(pred[32,1,768]{2,1,0} %b2, pred[] %c3), padding=0_4064x0_0x0_0
  %copy.2.d = s32[8]{0} copy(%c1), sharding={devices=[4,2]<=[8] last_tile_dim_replicate}
  %custom-call.3.d = s32[2]{0} custom-call(%copy.2.d), custom_call_target="SPMDFullToShardShape", sharding={devices=[1,4,2]<=[8] last_tile_dims={manual, replicated}}, backend_config="unspecified_dims=[0]"
  %copy.1.d = s32[2]{0} copy(%custom-call.3.d), sharding={devices=[2,4]<=[4,2]T(1,0) last_tile_dims={manual}}
  %multiply.0.d = s32[2]{0} multiply(%copy.1.d, %copy.1.d), sharding={devices=[2,4]<=[4,2]T(1,0) last_tile_dims={manual}}
  %collective-permute.0.d = s32[2]{0} collective-permute(%multiply.0.d), channel_id=1, source_target_pairs={{0,6},{2,0},{4,2},{6,4},{1,7},{3,1},{5,3},{7,5}}, sharding={devices=[2,4]<=[4,2]T(1,0) last_tile_dims={manual}}
  %custom-call.11.d = s32[8]{0} custom-call(%collective-permute.0.d), custom_call_target="SPMDShardToFullShape", sharding={devices=[8]<=[8]}, backend_config="unspecified_dims=[0]"
  %ffl.root = (pred[4096,1,768]{2,1,0}, s32[8]{0}) tuple(%p4, %custom-call.11.d)
  %custom-call.11 = s32[8]{0} custom-call(collective-permute.0), custom_call_target="SPMDShardToFullShape", sharding={devices=[8]<=[8]}, backend_config="unspecified_dims=[0]"
  ROOT %ffl.root.1 = (s32[8]{0}, pred[4096,1,768]{2,1,0}, s32[8]{0}) tuple(%custom-call.11, %p4, %custom-call.11.d)
}
