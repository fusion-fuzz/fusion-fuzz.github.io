HloModule module

%numpy_order_comparator {
  %lhs = bf16[] parameter(0)
  %lhs_is_nan = pred[] compare(lhs, lhs), direction=NE
  %c_nan = bf16[] constant(nan)
  %c_zero = bf16[] constant(0)
  %lhs_is_zero = pred[] compare(lhs, c_zero), direction=EQ
  %lhs_no_neg_zero = bf16[] select(lhs_is_zero, c_zero, lhs)
  %lhs_no_neg_zero_or_nan = bf16[] select(lhs_is_nan, c_nan, lhs_no_neg_zero)
  %rhs = bf16[] parameter(1)
  %rhs_is_nan = pred[] compare(rhs, rhs), direction=NE
  %rhs_is_zero = pred[] compare(rhs, c_zero), direction=EQ
  %rhs_no_neg_zero = bf16[] select(rhs_is_zero, c_zero, rhs)
  %rhs_no_neg_zero_or_nan = bf16[] select(rhs_is_nan, c_nan, rhs_no_neg_zero)
  ROOT %compare.20017 = pred[] compare(lhs_no_neg_zero_or_nan, rhs_no_neg_zero_or_nan), direction=GT, order=TOTAL
}

ENTRY %main {
  %p = bf16[8] parameter(0)
  %nans_and_zeros = bf16[8] constant({nan, -nan, nan, -nan, 0.0, -0.0, 0.0, -0.0})
  %values = bf16[16] concatenate(p, nans_and_zeros), dimensions={0}
  %sort = bf16[16] sort(values), dimensions={0}, is_stable=true, to_apply=numpy_order_comparator
  %parameter.1 = f32[8] parameter(1)
  %slice.19 = f32[7] slice(%p), slice={[0:7]}
  %constant.7 = f32[] constant(1)
  %broadcast.8 = f32[7] broadcast(%constant.7), dimensions={}
  %slice.19.d = f32[7] slice(%parameter.1), slice={[0:7]}
  %constant.7.d = f32[] constant(1)
  %broadcast.8.d = f32[7] broadcast(%constant.7.d), dimensions={}
  %add.9.d = f32[7] add(%slice.19.d, %broadcast.8.d)
  %constant.10.d = s32[] constant(1)
  %dynamic-update-slice.1.d = f32[8] dynamic-update-slice(%parameter.1, %add.9.d, %constant.10.d)
  %add.9 = f32[7] add(%slice.19, %broadcast.8)
  %constant.10 = s32[] constant(1)
  %dynamic-update-slice.1 = f32[8] dynamic-update-slice(%parameter.1, %add.9, %constant.10)
  %ffl.root = (bf16[16], f32[8]) tuple(%sort, %dynamic-update-slice.1)
  ROOT %ffl.root.1 = (bf16[16], f32[8], f32[8]) tuple(%sort, %dynamic-update-slice.1, %dynamic-update-slice.1.d)
}
