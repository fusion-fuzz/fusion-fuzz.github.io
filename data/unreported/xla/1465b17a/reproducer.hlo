  %ar.1 = bf16[1,8,128] all-reduce(mul), replica_groups={}, to_apply=%add.d.1, channel_id=1
  %ar.2 = bf16[1,8,128] all-reduce(ar.1), replica_groups={}, to_apply=%add.d.1, channel_id=1
