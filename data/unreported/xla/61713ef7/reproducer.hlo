HloModule SortCanShareWithTupleUser

%compare {
  %p0 = f32[] parameter(0)
  %p1 = f32[] parameter(1)
  %p2 = f32[] parameter(2)
  %p3 = f32[] parameter(3)
  ROOT %cmp = pred[] compare(p0, p2), direction=LT
}

%compare.d {
  %p0 = f32[] parameter(0)
  %p1 = f32[] parameter(1)
  %p2 = f32[] parameter(2)
  %p3 = f32[] parameter(3)
  ROOT %cmp = pred[] compare(p0, p2), direction=LT
}

ENTRY %main {
  %keys = f32[8] parameter(0)
  %values = f32[8] parameter(1)
  %sort = (f32[8], f32[8]) sort(keys, values), dimensions={0}, to_apply=compare
  %input = s8[1,17,9,9] parameter(2)
  %filter = s8[3,3,17,32] parameter(3)
  %inputs32 = s32[1,17,9,9] convert(%input)
  %filters32 = s32[3,3,17,32] convert(%filter)
  %conv = s32[1,32,9,9] convolution(%inputs32, %filters32), window={size=3x3 pad=1_1x1_1}, dim_labels=bf01_01io->bf01
  %convert = f32[1,32,9,9] convert(%conv)
  %keys.d = f32[8] parameter(4)
  %values.d = f32[8] parameter(5)
  %sort.d = (f32[8], f32[8]) sort(%keys.d, %values.d), dimensions={0}, to_apply=%compare.d
  %ffl.root = (f32[1,32,9,9], (f32[8], f32[8])) tuple(%convert, %sort)
  ROOT %ffl.root.1 = ((f32[8], f32[8]), f32[1,32,9,9], (f32[8], f32[8])) tuple(%sort, %convert, %sort)
}
